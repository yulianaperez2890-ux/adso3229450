<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="30dp"
    android:background="#F8F5FF"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="30dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logotipo"
        tools:ignore="ImageContrastCheck" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Bienvenido a Planify Day!"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#593A85"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organiza tu tiempo, cumple tus metas y haz que cada día cuente."
        android:textSize="16sp"
        android:textColor="#777080"
        android:gravity="center"
        android:layout_marginBottom="45dp" />

    <Button
        android:id="@+id/btnRegistrarse"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Registrarse"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#8055B5"
        android:layout_marginBottom="15dp" />

    <Button
        android:id="@+id/btnIniciarSesion"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Iniciar sesión"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#8055B5"
        android:backgroundTint="#E8DDF7" />

</LinearLayout>